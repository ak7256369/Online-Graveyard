rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Memorial Media ──────────────────────────────────
    match /memorials/{memorialId}/{allPaths=**} {

      // Anyone can read/download media files
      allow read: if true;

      // Anyone can upload (no auth required for MVP)
      // Restrict to images and videos, max 10MB for images, 100MB for videos
      allow write: if request.resource.size < 100 * 1024 * 1024 // 100MB max
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));

      // Allow delete for cleanup
      allow delete: if true;
    }

    // Deny access to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
