rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users Collection ─────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Memorials Collection ─────────────────────────────
    match /memorials/{memorialId} {

      // Anyone can read memorials
      allow read: if true;

      // Anyone can create a memorial (no auth required for MVP)
      allow create: if request.resource.data.keys().hasAll(['name', 'birthDate', 'deathDate', 'createdAt', 'createdBy'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200;

      // Allow updates — for candle/flower increments and profile edits
      allow update: if true;

      // Allow delete — for memorial owners (or anyone in MVP)
      allow delete: if true;

      // ─── Tributes Sub-collection ──────────────────────
      match /tributes/{tributeId} {

        // Anyone can read tributes
        allow read: if true;

        // Anyone can create a tribute with required fields
        allow create: if request.resource.data.keys().hasAll(['authorName', 'message', 'createdAt'])
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() > 0
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 2000;

        // Allow updates for candle increments
        allow update: if true;

        // Allow delete
        allow delete: if true;
      }
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
